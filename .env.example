# Copy to .env for local live runs. Never commit .env.
# GitHub Actions maps secrets.DEEPINFRA_API_TOKEN to this variable.
DEEPINFRA_TOKEN=

# Required for every live run: cad_10, cad_15, or cad_20.
VIDEO_GEN_BUDGET_PROFILE=cad_10

# Dry-run is the default. Live execution must require an explicit command flag.
VIDEO_GEN_DRY_RUN=true

# Intentionally absent from the initial DeepInfra OSS-only proof:
# OPENAI_API_KEY
# ELEVENLABS_API_KEY
# GEMINI_API_KEY
# GOOGLE_API_KEY
# GOOGLE_APPLICATION_CREDENTIALS
